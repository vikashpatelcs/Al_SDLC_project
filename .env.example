# FinReq / AI Requirement Engineer Environment Configuration
# Rule: OFFLINE OPEN-WEIGHTS MODELS ONLY. NO HOSTED/PAID APIS.

# Local LLM Gateway (Ollama)
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_FALLBACK_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=60

# Application & API
APP_ENV=development
APP_PORT=8000
APP_SECRET=replace_with_a_secure_random_secret_in_production

# Database (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./backend/app.db

# Vector Store / RAG (Local ChromaDB)
CHROMA_PERSIST_DIR=./kb/processed/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# PII Masking & Security
MASKING_ENABLED=true

# Storage Directories
STORAGE_UPLOADS=./storage/uploads
STORAGE_GENERATED=./storage/generated
